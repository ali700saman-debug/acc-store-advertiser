# ============================================================
# ACC STORE Advertiser — environment variables
# Copy to .env for local development. On Railway set these as
# service variables. NEVER commit a real .env file.
# ============================================================

# --- Required ---------------------------------------------------------------

# Bot token from @BotFather for the ADVERTISING bot (not your main store bot).
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Numeric Telegram user IDs allowed to use the admin panel, comma separated.
# Get yours from @userinfobot. Usernames are NOT accepted.
ADMIN_IDS=123456789,987654321

# --- MTProto user account (sends the advertisements) ------------------------
# The advertisements are posted by a NORMAL Telegram account, not by the bot.
# The bot above stays as your private admin panel.

# From https://my.telegram.org -> API development tools, created while signed
# in as the DEDICATED ADVERTISING ACCOUNT.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=replace_with_your_api_hash

# Generated ONCE on your own computer with:  npm run login:user
# TREAT THIS LIKE A PASSWORD. Anyone holding it can act as that Telegram
# account. Never commit it, never paste it into a chat, never log it.
TELEGRAM_USER_SESSION=paste_the_generated_session_string_here

# Delay between two consecutive user-account sends, in ms. Keep it
# conservative: a user account is rate limited far more aggressively than a bot.
USER_SEND_DELAY_MS=20000

# Set to false to run the admin panel with automatic user sending switched off.
USER_SENDER_ENABLED=true

# --- Database ---------------------------------------------------------------

# On Railway, mount a persistent volume at /data and keep this path.
# For local development use ./data/advertiser.db
DB_PATH=/data/advertiser.db

# --- Advertisement defaults -------------------------------------------------

# Link the default campaign button points at (your MAIN ACC STORE bot).
MAIN_STORE_BOT_URL=https://t.me/YourStoreBot

# Optional: used to build the URL if MAIN_STORE_BOT_URL is not set.
MAIN_STORE_BOT_USERNAME=YourStoreBot

# Default gap between advertisements, in minutes (360 = 6 hours).
DEFAULT_AD_INTERVAL_MINUTES=360

# Hard floor for any interval, in minutes. Protects against accidental spam.
MIN_INTERVAL_MINUTES=60

# Timezone used for quiet hours and all displayed times (IANA name).
TZ=Asia/Baghdad

# Where campaign media is cached so the user account can upload it.
# Defaults to a "media" folder next to the database, i.e. on the same volume.
# MEDIA_DIR=/data/media

# --- Optional tuning --------------------------------------------------------

# How often the scheduler checks which groups are due (ms). It only CHECKS;
# actual sending still respects each group's interval.
SCHEDULER_TICK_MS=60000

# Pause between two group sends during a batch (ms). Respects Telegram limits.
SEND_DELAY_MS=3000

# Maximum advertisements one scheduler tick may send.
MAX_SENDS_PER_TICK=25

# Retry attempts for Telegram 429 / transient network errors.
MAX_RETRY_ATTEMPTS=2

# Set to false to boot the admin panel without the automatic scheduler.
SCHEDULER_ENABLED=true

# Set to true only if you explicitly want to register channels as well.
ALLOW_CHANNELS=false
